# ============================================================================
# AI CHATBOT SAAS PLATFORM - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and update with your actual values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=password
DB_NAME=ai_chatbot_db

# ============================================================================
# JWT CONFIGURATION
# ============================================================================
# IMPORTANT: Change this to a secure random string (minimum 32 characters)
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars-long-xxxxxxxxxxxxxxxx
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ============================================================================
# OPENAI CONFIGURATION
# Get your API key from: https://platform.openai.com/account/api-keys
# ============================================================================
OPENAI_API_KEY=sk-your-actual-openai-api-key-here
OPENAI_API_URL=https://api.openai.com/v1/embeddings
OPENAI_MODEL=text-embedding-ada-002

# ============================================================================
# RAZORPAY CONFIGURATION
# Get your keys from: https://dashboard.razorpay.com/#/app/keys
# ============================================================================
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# ============================================================================
# SERVICE DISCOVERY & REGISTRY
# ============================================================================
EUREKA_URL=http://localhost:8761/eureka

# ============================================================================
# FILE UPLOAD CONFIGURATION
# ============================================================================
FILE_UPLOAD_DIR=uploads
WIDGET_API_URL=http://localhost:8086/api/v1/widget
MAX_FILE_SIZE=10485760

# ============================================================================
# ELASTICSEARCH CONFIGURATION
# ============================================================================
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX=chatbot_embeddings

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================
MAIL_SENDER=noreply@chatbotSaaS.com
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=your-email@gmail.com
MAIL_SMTP_PASSWORD=your-app-password

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=DEBUG

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:8080

# ============================================================================
# SUBSCRIPTION PRICING (in INR)
# ============================================================================
PLAN_STARTER_MONTHLY=299
PLAN_PROFESSIONAL_MONTHLY=999
PLAN_ENTERPRISE_MONTHLY=2999
PLAN_YEARLY_DISCOUNT=0.10

# ============================================================================
# PAGINATION & LIMITS
# ============================================================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
MAX_UPLOAD_SIZE_MB=10
MAX_DOCUMENTS_PER_USER=100
MAX_CHATBOTS_PER_USER=10

# ============================================================================
# FEATURE FLAGS
# ============================================================================
FEATURE_EMAIL_VERIFICATION=false
FEATURE_TWO_FACTOR_AUTH=false
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_CUSTOM_DOMAIN=false

# ============================================================================
# GOOGLE ANALYTICS (Optional)
# ============================================================================
GOOGLE_ANALYTICS_ID=

# ============================================================================
# SENTRY ERROR TRACKING (Optional)
# ============================================================================
SENTRY_DSN=

# ============================================================================
# DOCUMENTATION
# ============================================================================
# JWT_SECRET should be a random string of at least 32 characters
# Example: openssl rand -base64 32
#
# OPENAI_API_KEY: Get from https://platform.openai.com/account/api-keys
#
# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Get from Razorpay Dashboard
# Test mode keys start with 'rzp_test_' and live keys start with 'rzp_live_'
#
# FILE_UPLOAD_DIR: Directory where uploaded files will be stored
#
# For production deployment:
# 1. Use strong JWT_SECRET
# 2. Set APP_ENV=production
# 3. Use HTTPS URLs for all endpoints
# 4. Configure proper email SMTP settings
# 5. Set up SENTRY_DSN for error tracking
# 6. Enable EMAIL_VERIFICATION
# ============================================================================

